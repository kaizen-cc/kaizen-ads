{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/context?step=slack",
      "schedule": "0,30 * * * *"
    },
    {
      "path": "/api/cron/context?step=drive",
      "schedule": "4,34 * * * *"
    },
    {
      "path": "/api/cron/context?step=gmail",
      "schedule": "8,38 * * * *"
    },
    {
      "path": "/api/cron/context?step=meta",
      "schedule": "20 * * * *"
    },
    {
      "path": "/api/cron/context?step=kpi",
      "schedule": "45 */2 * * *"
    },
    {
      "path": "/api/cron/context?step=brief",
      "schedule": "15 16,17,22,23 * * *"
    },
    {
      "path": "/api/cron/context?step=suggest",
      "schedule": "30 12,13 * * 1-5"
    },
    {
      "path": "/api/cron/context?step=clients",
      "schedule": "50 * * * *"
    },
    {
      "path": "/api/cron/context?step=calls",
      "schedule": "25,55 * * * *"
    },
    {
      "path": "/api/cron/context?step=gtm",
      "schedule": "10 * * * *"
    },
    {
      "path": "/api/cron/context?step=verticals",
      "schedule": "35 * * * *"
    },
    {
      "path": "/api/cron/context?step=market",
      "schedule": "30 12,13 * * *"
    },
    {
      "path": "/api/cron/context?step=sprints",
      "schedule": "20 * * * *"
    }
  ]
}
