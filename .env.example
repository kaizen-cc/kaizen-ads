# Copy to .env.local for local dev. Production values live in Vercel → kaizen-ads → Settings → Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://caoylechcdddxtvjnaef.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_wJl2qdXD9swyXubMa054NA_IwPI8WeB
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=https://ads.kaizenmarketing.agency
RESEND_API_KEY=
RESEND_FROM_EMAIL=Kaizen Ads <ads@contact.kaizenmarketing.agency>
CRON_SECRET=
ERROR_ALERT_EMAIL=santi@kaizenmarketing.agency
# Claude: request-form suggestions and the request review. Without it the form works, minus the AI.
ANTHROPIC_API_KEY=
# Only if the key is an org-level key (not created inside a workspace): the workspace its usage belongs to.
ANTHROPIC_WORKSPACE_ID=
# Client briefings (12pm and 6pm ET). Vercel Cron sends CRON_SECRET; set it to any long random string.
# Slack: the Kaizen OS Slack app's Bot User OAuth Token (xoxb-…)
SLACK_BOT_TOKEN=
# Google Workspace service account with domain-wide delegation (gmail.readonly, drive.readonly, admin.directory.user.readonly)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Umbrella folder (or shared drive) with one folder per client, and someone who can open it
GOOGLE_SHARED_DRIVE_ID=
GOOGLE_DRIVE_USER=
# A Workspace admin to look up mailboxes as (defaults to GOOGLE_DRIVE_USER)
GOOGLE_ADMIN_USER=
# Leave empty to read every mailbox in the org (new people included automatically), or list specific ones
GMAIL_MAILBOXES=
# Zapier sends this as x-kaizen-secret on /api/zapier/* (enrollment, upsell, slack-channel)
ZAPIER_SECRET=
# Loom videos into the agents' knowledge: the token Zapier, an email rule or the Loom browser script sends to /api/loom
LOOM_WEBHOOK_TOKEN=
# Loom through Atlassian's official MCP server (https://mcp.atlassian.com/v2/mcp): every new Loom pulled in by the
# cron's Loom step, and private or workspace-only transcripts read. Needs the Loom workspace linked to an Atlassian
# Cloud site, and an org admin turning on API-token sign-in at admin.atlassian.com › Connectors › Atlassian MCP server.
# Either a personal API token (id.atlassian.com › Security › API tokens) with the email of the account it belongs to:
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=
# Optional: when that token expires (YYYY-MM-DD; tokens last a year at most). An exec can set it on the Settings card
# instead; the execs are notified 30, 14, 7 and 1 days before.
ATLASSIAN_TOKEN_EXPIRES_AT=
# or a service account key (sent as Bearer; used instead of the two above when set):
ATLASSIAN_SERVICE_KEY=
# Optional: the Atlassian site's cloud id, when the account sees several sites (found by itself otherwise)
ATLASSIAN_CLOUD_ID=
# Optional: another MCP endpoint (defaults to https://mcp.atlassian.com/v2/mcp)
ATLASSIAN_MCP_URL=
